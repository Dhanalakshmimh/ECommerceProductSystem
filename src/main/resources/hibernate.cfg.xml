<?xml version="1.0" encoding="UTF-8"?>

<hibernate-configuration>

	<session-factory>
	
	<property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
		<property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/employee
		</property>
		<property name="hibernate.connection.username">postgres</property>
		<property name="hibernate.connection.password">root</property>

		<property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect
		</property>
		<property name="hibernate.show_sql">true</property>
		<property name="hibernate.hbm2ddl.auto">create</property>
		<mapping class="com.EmployeeManagementSystem.entity.Employee"/>
		<mapping class="com.EmployeeManagementSystem.entity.Department"/>
		<mapping class="com.EmployeeManagementSystem.entity.Address"/>
		<mapping class="com.EmployeeManagementSystem.entity.Project"/>
		
		
		
		
    </session-factory>

</hibernate-configuration>
